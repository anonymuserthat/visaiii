# Frontend settings (these values are bundled into the desktop build)
VITE_BOOKING_BASE_URL=https://visa-fr-dz.capago.eu/rendezvous_annaba
VITE_MOCK_MODE=false
VITE_DEFAULT_LOCALE=fr

# Backend only: used at runtime, never bundled into the frontend or installer.
# Restart the desktop app after editing. A key saved in the app takes priority.
TWOCAPTCHA_API_KEY=

# Database connection is NOT bundled into the installer.
# For local development or a developer Tauri run, set the Neon connection here
# in a non-committed .env file. It takes priority over any saved runtime.env.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
