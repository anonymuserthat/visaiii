# Frontend settings (these values are bundled into the desktop build)
VITE_BOOKING_BASE_URL=https://visa-fr-dz.capago.eu/rendezvous_annaba
VITE_MOCK_MODE=false
VITE_DEFAULT_LOCALE=fr

# Backend only: used at runtime, never bundled into the frontend or installer.
TWOCAPTCHA_API_KEY=

# Storage uses the configured shard pool. Set SHARD_001_DATABASE_URL through
# SHARD_100_DATABASE_URL in the non-committed .env file.
SHARD_001_DATABASE_URL=postgresql://user:password@host.example/neondb?sslmode=require
SHARD_002_DATABASE_URL=postgresql://user:password@host.example/neondb?sslmode=require
# ...
SHARD_100_DATABASE_URL=postgresql://user:password@host.example/neondb?sslmode=require
